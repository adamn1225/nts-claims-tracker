    phone: "555-0104",
    email: "lisa@pacificlumber.com",
    industry: "Lumber & Building Materials",
    city: "Los Angeles",
    state: "CA",
    status: "prospect",
    shipping_frequency: "bi_weekly",
    is_pinned: false,
    last_contact_date: new Date(
      Date.now() - 7 * 24 * 60 * 60 * 1000,
    ).toISOString(),
