  },
  {
    id: "5",
    customer_id: "NS-1005",
    broker_id: "user-123",
    business_name: "Southern Concrete & Aggregates",
    contact_name: "Robert Taylor",
    phone: "555-0105",
    email: "robert@southernconcrete.com",
    industry: "Concrete & Aggregates",
    city: "Atlanta",
    state: "GA",
    status: "won",
    shipping_frequency: "weekly",
    is_pinned: false,
    last_contact_date: new Date(
      Date.now() - 30 * 24 * 60 * 60 * 1000,
    ).toISOString(),
    estimated_value: 75000,
    created_at: new Date().toISOString(),
    updated_at: new Date().toISOString(),
  },
];

export default function CustomersPage() {
  const [customers, setCustomers] = useState<Customer[]>(mockCustomers);
  const [searchQuery, setSearchQuery] = useState("");
  const [view, setView] = useState<"kanban" | "list" | "calendar">("kanban");
  const [showFilters, setShowFilters] = useState(false);
  const [showCustomerModal, setShowCustomerModal] = useState(false);
  const [editingCustomer, setEditingCustomer] = useState<Customer | null>(null);

  // TODO: Replace with actual broker ID from auth context
  const currentBrokerId = "user-123";

  // TODO: Replace with Supabase real-time subscription
  useEffect(() => {
    // Fetch customers from Supabase
    // const fetchCustomers = async () => {
    //   const { data, error } = await supabase
    //     .from('customers')
    //     .select('*')
    //     .eq('broker_id', currentUser.id)
    //     .order('is_pinned', { ascending: false })
    //     .order('pin_order', { ascending: true });
    //
    //   if (data) setCustomers(data);
    // };
    // fetchCustomers();
  }, []);

  const handlePinCustomer = async (customerId: string) => {
    // TODO: Implement Supabase update
    setCustomers((prev) =>
      prev.map((c) => {
        if (c.id === customerId) {
          const newPinState = !c.is_pinned;
          return {
            ...c,
            is_pinned: newPinState,
            pin_order: newPinState ? Date.now() : undefined,
          };
        }
        return c;
      }),
    );

    console.log("Pin toggled for customer:", customerId);
  };

  const handleEditCustomer = (customer: Customer) => {
    setEditingCustomer(customer);
    setShowCustomerModal(true);
  };

  const handleQuickAction = (
    action: "call" | "email" | "schedule" | "notes",
    customer: Customer,
  ) => {
    // TODO: Implement quick actions
    console.log(`Quick action: ${action} for`, customer.business_name);

    if (action === "call") {
      // Option 1: Open tel: link
      if (customer.phone) {
        window.location.href = `tel:${customer.phone}`;
      }
    } else if (action === "email") {
      // Option 2: Open mailto: link
      if (customer.email) {
        window.location.href = `mailto:${customer.email}`;
      }
    } else if (action === "notes") {
      // handled inside Kanban board modal
      return;
    } else if (action === "schedule") {
      // Option 3: Open schedule modal
      // TODO: Implement scheduling modal
    }
  };

  const handleAddNote = (
    customerId: string,
    note: string,
    followUpDate?: string,
    followUpType?: "call" | "email" | "online_meeting" | "follow_up",
  ) => {
    setCustomers((prev) =>
      prev.map((c) =>
        c.id === customerId
          ? {
              ...c,
              next_follow_up_date: followUpDate || c.next_follow_up_date,
              next_follow_up_type: followUpDate
                ? followUpType || c.next_follow_up_type || "follow_up"
                : c.next_follow_up_type,
            }
          : c,
      ),
    );

    if (followUpDate) {
      console.log(
        `Note saved and follow-up scheduled on ${followUpDate} for ${customerId} (${followUpType || "follow_up"}): ${note}`,
      );
    } else {
      console.log(`Note saved for ${customerId}: ${note}`);
    }
  };

  const handleAddCustomer = (status?: CustomerStatus) => {
    setEditingCustomer(null);
    setShowCustomerModal(true);
    // TODO: Pre-fill status when creating from specific column
  };

  const handleSaveCustomer = async (customerData: Partial<Customer>) => {
    try {
      if (editingCustomer) {
        // Update existing customer
        // TODO: Update in Supabase
        setCustomers((prev) =>
          prev.map((c) =>
            c.id === editingCustomer.id ? { ...c, ...customerData } : c,
          ),
        );
        console.log("Updated customer:", customerData);
      } else {
        // Create new customer
        // TODO: Insert into Supabase and get generated customer_id
        const newCustomer: Customer = {
          id: `customer-${Date.now()}`,
          customer_id: `NS-${1001 + customers.length}`,
          ...customerData,
          is_pinned: false,
          created_at: new Date().toISOString(),
          updated_at: new Date().toISOString(),
        } as Customer;

        setCustomers((prev) => [newCustomer, ...prev]);
        console.log("Created customer:", newCustomer);
      }
    } catch (error) {
      console.error("Error saving customer:", error);
      throw error;
    }
  };

  const handleStatusChange = (customerId: string, newStatusId: string) => {
    setCustomers((prev) =>
      prev.map((c) =>
        c.id === customerId
          ? { ...c, status: newStatusId as CustomerStatus }
          : c,
      ),
    );
    console.log(`Customer ${customerId} moved to status: ${newStatusId}`);
    // TODO: Update in Supabase
  };

  const handleAddTask = (date: Date) => {
    // TODO: Open schedule modal with pre-filled date
    console.log("Schedule task for date:", date.toLocaleDateString());
  };

  const filteredCustomers = customers.filter((customer) => {
    if (!searchQuery) return true;
    const query = searchQuery.toLowerCase();
    return (
      customer.business_name.toLowerCase().includes(query) ||
      customer.contact_name.toLowerCase().includes(query) ||
      customer.email?.toLowerCase().includes(query) ||
      customer.industry?.toLowerCase().includes(query)
    );
  });

  const stats = {
    total: customers.length,
    prospects: customers.filter((c) => c.status === "prospect").length,
    active: customers.filter((c) => c.status === "active").length,
    won: customers.filter((c) => c.status === "won").length,
    pinned: customers.filter((c) => c.is_pinned).length,
    overdue: customers.filter(
      (c) =>
        c.next_follow_up_date && new Date(c.next_follow_up_date) < new Date(),
    ).length,
  };

  return (
    <div className="min-h-screen bg-slate-50">
      {/* Header */}
      <div className="border-b border-slate-200 bg-white">
        <div className="px-4 py-4 sm:px-6">
          <div className="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h1 className="text-xl font-bold text-slate-900 sm:text-2xl">
                Book of Business
              </h1>
              <p className="text-sm text-slate-600">
                Manage your customers and track opportunities
              </p>
            </div>
            <button
              onClick={() => handleAddCustomer()}
              className="flex h-11 items-center justify-center gap-2 rounded-lg bg-orange-500 px-4 py-2 font-medium text-white shadow-sm transition-colors hover:bg-orange-600"
            >
              <Plus className="h-5 w-5" />
              <span>New Customer</span>
            </button>
          </div>

          {/* Stats Bar - Horizontal scroll on mobile */}
          <div className="mb-4 -mx-4 px-4 sm:mx-0 sm:px-0">
            <div className="flex gap-3 overflow-x-auto sm:grid sm:grid-cols-3 sm:overflow-x-visible lg:grid-cols-6">
              <div className="rounded-lg bg-slate-50 p-3">
                <div className="text-xs text-slate-600">Total</div>
                <div className="text-xl font-bold text-slate-900">
                  {stats.total}
                </div>
              </div>
              <div className="rounded-lg bg-blue-50 p-3">
                <div className="text-xs text-blue-600">Prospects</div>
                <div className="text-xl font-bold text-blue-900">
                  {stats.prospects}
                </div>
              </div>
              <div className="rounded-lg bg-green-50 p-3">
                <div className="text-xs text-green-600">Active</div>
                <div className="text-xl font-bold text-green-900">
                  {stats.active}
                </div>
              </div>
              <div className="rounded-lg bg-amber-50 p-3">
                <div className="text-xs text-amber-600">Won</div>
                <div className="text-xl font-bold text-amber-900">
                  {stats.won}
                </div>
              </div>
              <div className="rounded-lg bg-orange-50 p-3">
                <div className="text-xs text-orange-600">Pinned</div>
                <div className="text-xl font-bold text-orange-900">
                  {stats.pinned}
                </div>
              </div>
              <div className="rounded-lg bg-red-50 p-3">
                <div className="text-xs text-red-600">Overdue</div>
                <div className="text-xl font-bold text-red-900">
                  {stats.overdue}
                </div>
              </div>
            </div>

            {/* Search & View Controls */}
            <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              {/* Search */}
              <div className="relative flex-1">
                <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
                <input
                  type="text"
                  placeholder="Search customers..."
                  value={searchQuery}
                  onChange={(e) => setSearchQuery(e.target.value)}
                  className="h-11 w-full rounded-lg border border-slate-200 py-2 pl-10 pr-4 text-sm focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-opacity-20"
                />
              </div>

              {/* View Toggles */}
              <div className="flex gap-2">
                <button
                  onClick={() => setShowFilters(!showFilters)}
                  className={`flex h-11 items-center gap-2 rounded-lg border px-3 py-2 text-sm font-medium transition-colors ${
                    showFilters
                      ? "border-orange-500 bg-orange-50 text-orange-700"
                      : "border-slate-200 bg-white text-slate-700 hover:bg-slate-50"
                  }`}
                >
                  <Filter className="h-4 w-4" />
                  <span className="hidden sm:inline">Filters</span>
                </button>

                <div className="flex rounded-lg border border-slate-200 bg-white">
                  <button
                    onClick={() => setView("kanban")}
                    className={`flex h-11 w-11 items-center justify-center rounded-l-lg transition-colors ${
                      view === "kanban"
                        ? "bg-orange-500 text-white"
                        : "text-slate-600 hover:bg-slate-50"
                    }`}
                    title="Kanban View"
                    aria-label="Kanban View"
                  >
                    <LayoutGrid className="h-4 w-4" />
                  </button>
                  <button
                    onClick={() => setView("list")}
                    className={`flex h-11 w-11 items-center justify-center border-x border-slate-200 transition-colors ${
                      view === "list"
                        ? "bg-orange-500 text-white"
                        : "text-slate-600 hover:bg-slate-50"
                    }`}
                    title="List View"
                    aria-label="List View"
                  >
                    <List className="h-4 w-4" />
                  </button>
                  <button
                    onClick={() => setView("calendar")}
                    className={`flex h-11 w-11 items-center justify-center rounded-r-lg transition-colors ${
                      view === "calendar"
                        ? "bg-orange-500 text-white"
                        : "text-slate-600 hover:bg-slate-50"
                    }`}
                    title="Calendar View"
                    aria-label="Calendar View"
                  >
                    <CalendarIcon className="h-4 w-4" />
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Main Content */}
        <div className="p-4 sm:p-6">
          {view === "kanban" && (
            <KanbanBoard
              customers={filteredCustomers}
              onPin={handlePinCustomer}
              onEdit={handleEditCustomer}
              onQuickAction={handleQuickAction}
              onAddCustomer={handleAddCustomer}
              onStatusChange={handleStatusChange}
              onAddNote={handleAddNote}
            />
          )}

          {view === "list" && (
            <ListView
              customers={filteredCustomers}
              onPin={handlePinCustomer}
              onEdit={handleEditCustomer}
              onQuickAction={handleQuickAction}
            />
          )}

          {view === "calendar" && (
            <CalendarView
              customers={filteredCustomers}
              onEdit={handleEditCustomer}
              onQuickAction={handleQuickAction}
              onAddTask={handleAddTask}
            />
          )}
        </div>
      </div>

      {/* Customer Form Modal */}
      <CustomerFormModal
        isOpen={showCustomerModal}
        onClose={() => {
          setShowCustomerModal(false);
          setEditingCustomer(null);
        }}
        onSave={handleSaveCustomer}
        customer={editingCustomer}
        brokerId={currentBrokerId}
      />
    </div>
  );
}
