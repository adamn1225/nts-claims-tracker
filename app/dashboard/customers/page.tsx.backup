    updated_at: new Date().toISOString(),
  },
  {
    id: "3",
    customer_id: "NS-1003",
    broker_id: "user-123",
    business_name: "Texas Machinery & Equipment",
    contact_name: "Mike Davis",
    phone: "555-0103",
    email: "mike@texasmachinery.com",
    industry: "Heavy Equipment Manufacturing",
    city: "Dallas",
    state: "TX",
    status: "active",
    shipping_frequency: "multiple_per_week",
    is_pinned: true,
    pin_order: 2,
    last_contact_date: new Date(
      Date.now() - 1 * 24 * 60 * 60 * 1000,
    ).toISOString(),
    next_follow_up_date: new Date(
      Date.now() + 7 * 24 * 60 * 60 * 1000,
    ).toISOString(),
    next_follow_up_type: "online_meeting",
    estimated_value: 100000,
    created_at: new Date().toISOString(),
    updated_at: new Date().toISOString(),
  },
  {
    id: "4",
    customer_id: "NS-1004",
    broker_id: "user-123",
    business_name: "Pacific Lumber & Building Materials",
