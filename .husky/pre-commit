#!/bin/bash

# NTS Claims Tracker - Pre-commit Hook
# This script runs automated checks before allowing a commit

echo "🔍 Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Track if any check fails
FAILED=0

# 1. TypeScript Type Check
echo -e "\n📘 Checking TypeScript types..."
if npm run type-check; then
    echo -e "${GREEN}✓ TypeScript types are valid${NC}"
else
    echo -e "${RED}✗ TypeScript type errors found${NC}"
    FAILED=1
fi

# 2. ESLint Check
echo -e "\n🔧 Running ESLint..."
if npm run lint; then
    echo -e "${GREEN}✓ No linting errors${NC}"
else
    echo -e "${RED}✗ Linting errors found${NC}"
    FAILED=1
fi

# 3. Check for console.log (warn only, don't fail)
echo -e "\n🐛 Checking for console.log statements..."
CONSOLE_LOGS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$' | xargs grep -n 'console\.log' || true)
if [ ! -z "$CONSOLE_LOGS" ]; then
    echo -e "${YELLOW}⚠ Warning: console.log statements found:${NC}"
    echo "$CONSOLE_LOGS"
    echo -e "${YELLOW}Consider removing console.log before committing to production${NC}"
fi

# 4. Check for TODO/FIXME (warn only)
echo -e "\n📝 Checking for TODO/FIXME comments..."
TODOS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$' | xargs grep -n -E 'TODO|FIXME' || true)
if [ ! -z "$TODOS" ]; then
    echo -e "${YELLOW}⚠ Warning: TODO/FIXME comments found:${NC}"
    echo "$TODOS"
fi

# 5. Check for .env files
echo -e "\n🔐 Checking for accidental .env commits..."
ENV_FILES=$(git diff --cached --name-only | grep -E '\.env' || true)
if [ ! -z "$ENV_FILES" ]; then
    echo -e "${RED}✗ ERROR: Attempting to commit .env files!${NC}"
    echo "$ENV_FILES"
    FAILED=1
fi

# Final result
echo -e "\n================================"
if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}✓ All checks passed! Proceeding with commit.${NC}"
    exit 0
else
    echo -e "${RED}✗ Pre-commit checks failed. Please fix the errors above.${NC}"
    echo -e "${YELLOW}To skip these checks (not recommended), use: git commit --no-verify${NC}"
    exit 1
fi
