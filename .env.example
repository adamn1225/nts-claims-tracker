# ─────────────────────────────────────────────────────────────────────────────
# Claims Tracker Starter — environment variables
# Copy this file to `.env.local` and fill in your own values. NEVER commit .env.
# Only the NEXT_PUBLIC_* values are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection strings (used by migrations / server tooling)
DATABASE_URL=
DIRECT_URL=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Encryption key for at-rest secrets (e.g. stored email config). 32+ chars.
ENCRYPTION_KEY=
MAX_PINNED_CUSTOMERS=10
DEFAULT_REMINDER_HOURS=24

# ── Auth (NextAuth / Microsoft SSO — optional, gated by features.microsoftSso) ─
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=

# ── AI (required when features.ai = true) ────────────────────────────────────
OPENAI_API_KEY=
# Optional web-research for the AI coach. Leave blank to disable web search.
TAVILY_API_KEY=

# ── Email notifications (optional, gated by features.emailNotifications) ──────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
SENDGRID_ENCRYPTION_KEY=
ENABLE_EMAIL_REMINDERS=false

# ── GoTo Connect calling (optional, gated by features.goto) ──────────────────
GOTO_CLIENT_ID=
GOTO_CLIENT_SECRET=
GOTO_REDIRECT_URI=

# ── Maps (optional, used by location features) ───────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=
